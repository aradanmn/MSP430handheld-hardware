  (text "Generated by scripts/gen_schematic.py from pcb/handheld_design.py - do not hand-edit." (exclude_from_sim no) (at 15.0000 388.0000 0) (effects (font (size 1.8 1.8) (thickness 0.270)) (justify left bottom)) (uuid "af955199-f26d-43d5-9e96-4a744965f2d9"))
  (text "Pin map follows the firmware course: P2.3 SR_LOAD, P2.4 AUDIO_PWM (TA1.2), P2.5 SRAM_CS, P2.6 FLASH_CS." (exclude_from_sim no) (at 15.0000 392.0000 0) (effects (font (size 1.8 1.8) (thickness 0.270)) (justify left bottom)) (uuid "20e2c2d0-38d3-4f2a-8a09-0dc2a3e1b990"))
  (text "J3 carries Spy-Bi-Wire (RST, TEST) and the UART to a LaunchPad eZ-FET; same signal order as its J101 block." (exclude_from_sim no) (at 15.0000 396.0000 0) (effects (font (size 1.8 1.8) (thickness 0.270)) (justify left bottom)) (uuid "c39d240e-ad1a-4e0a-aceb-40bf04e61a6c"))
  (text "R13 isolates the 74HC165's always-driven QH from the shared MISO line. R9-R11 hold the chip selects high during reset." (exclude_from_sim no) (at 15.0000 400.0000 0) (effects (font (size 1.8 1.8) (thickness 0.270)) (justify left bottom)) (uuid "76dd7109-472e-4c53-93d4-27efdeb55c77"))
  (text "SW9 grounds PWR_EN (PowerBoost EN + Pololu SHDN) to switch off; it carries no load current." (exclude_from_sim no) (at 15.0000 404.0000 0) (effects (font (size 1.8 1.8) (thickness 0.270)) (justify left bottom)) (uuid "0c6206f9-a368-45b6-b0f2-6313c998dd13"))
